# --- Application ---
APP_NAME=SuppleScope
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# PostgreSQL recommended for production and full multi-user deployment:
# DATABASE_URL=postgresql+psycopg2://supplescope:supplescope@localhost:5432/supplescope
# SQLite is the default local-development fallback for portability and testing.
DATABASE_URL=sqlite:///./data/supplescope.db

# --- Object storage (local filesystem; replaceable) ---
STORAGE_ROOT=./data/storage
MAX_UPLOAD_MB=80

# --- OCR ---
# Google Cloud Vision is optional; no credentials are required for local Tesseract OCR.
GOOGLE_APPLICATION_CREDENTIALS=
OCR_PRIMARY_PROVIDER=tesseract
OCR_SECONDARY_PROVIDER=google_vision
# Optional absolute path; set when Tesseract is not available on PATH.
TESSERACT_CMD=
# Directory containing ben.traineddata and eng.traineddata.
TESSDATA_PREFIX=

# --- Speech-to-text ---
# openai_whisper_api | faster_whisper | none
STT_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=whisper-1

# Local faster-whisper (optional; downloads a model on first use)
FASTER_WHISPER_MODEL=small

# --- Agentic AI (research only; never a verification verdict) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# --- Research tools ---
# Web search: tavily (preferred) or duckduckgo (no key)
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Crossref polite pool
CROSSREF_MAILTO=supplescope@example.edu

# OpenFDA (optional)
OPENFDA_API_KEY=

# NCBI PubMed (optional; higher rate limits)
NCBI_API_KEY=
NCBI_EMAIL=supplescope@example.edu

# --- Information extraction ---
# baseline | banglabert (loads Hugging Face model if installed)
EXTRACTION_BACKEND=baseline
BANGLABERT_MODEL_NAME=csebuetnlp/banglabert

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
