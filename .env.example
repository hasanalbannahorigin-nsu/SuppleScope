# --- Application ---
APP_NAME=SuppleScope
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# PostgreSQL recommended for production and full multi-user deployment:
# DATABASE_URL=postgresql+psycopg2://supplescope:supplescope@localhost:5432/supplescope
# SQLite is the default local-development fallback for portability and testing.
DATABASE_URL=sqlite:///./data/supplescope.db

# --- Object storage (local filesystem; replaceable) ---
STORAGE_ROOT=./data/storage
MAX_UPLOAD_MB=80

# --- OCR ---
# Google Cloud Vision is optional; no credentials are required for local Tesseract OCR.
GOOGLE_APPLICATION_CREDENTIALS=
OCR_PRIMARY_PROVIDER=tesseract
# Second engine: easyocr (local, Bengali + English; pip install -r backend/requirements-ml.txt) or google_vision
OCR_SECONDARY_PROVIDER=easyocr
EASYOCR_GPU=false
# Optional absolute path; set when Tesseract is not available on PATH.
TESSERACT_CMD=
# Directory containing ben.traineddata and eng.traineddata.
# Best accuracy: the tessdata_best models from github.com/tesseract-ocr/tessdata_best
TESSDATA_PREFIX=

# --- Speech-to-text ---
# openai_whisper_api | faster_whisper | none
STT_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=whisper-1

# Local faster-whisper (optional; downloads a model on first use). medium is recommended for Bangla.
FASTER_WHISPER_MODEL=medium
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
# Language hint (bn = Bangla); empty = auto-detect
STT_LANGUAGE=bn

# --- Agentic AI (research only; never a verification verdict) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# --- Research tools ---
# Web search: duckduckgo (no key), tavily (TAVILY_API_KEY) or merged (both, de-duplicated)
WEB_SEARCH_PROVIDER=merged
TAVILY_API_KEY=

# Crossref polite pool
CROSSREF_MAILTO=supplescope@example.edu

# OpenFDA (optional)
OPENFDA_API_KEY=

# NCBI PubMed (optional; higher rate limits)
NCBI_API_KEY=
NCBI_EMAIL=supplescope@example.edu

# --- Information extraction ---
# baseline | banglabert (loads Hugging Face model if installed) | grounded_llm (needs LLM key)
EXTRACTION_BACKEND=baseline
BANGLABERT_MODEL_NAME=csebuetnlp/banglabert

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Research agent v2 (product intelligence) ---
# Free option: Gemini through its OpenAI-compatible endpoint. Get a key at https://aistudio.google.com/apikey
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-flash-lite-latest
#   LLM_API_KEY=<your Gemini key>
# If your Gemini key starts with "AQ." and you get 400/401 errors, also set
#   LLM_PROVIDER=gemini
# which calls Gemini's own API (x-goog-api-key header) instead of the OpenAI-compatible one.
# legacy | v2
RESEARCH_AGENT=legacy
# duckduckgo (free, no key) | tavily (free tier, needs TAVILY_API_KEY)
# WEB_SEARCH_PROVIDER=duckduckgo
RESEARCH_MAX_SEARCH_CALLS=30
RESEARCH_MAX_FETCHES=20
RESEARCH_MAX_LLM_CALLS=80
RESEARCH_MAX_RETRIES_PER_CALL=2
RESEARCH_MAX_SECONDS=1200
RESEARCH_MAX_ROUNDS=3
# Ingredient / claim literature research (PubMed + Europe PMC, free, no key needed)
RESEARCH_MAX_LITERATURE_CALLS=60
RESEARCH_MAX_INGREDIENTS=6
RESEARCH_PAPERS_PER_QUERY=5
RESEARCH_LITERATURE_PROVIDERS=pubmed,europepmc

# --- Completed stack (docs/STACK_COMPLETION.md) ---
# PubMed effect searches try reviews / RCTs / meta-analyses / clinical trials first
RESEARCH_PUBMED_STUDY_FILTER=true
# ClinicalTrials.gov registry search (registered trials are context only, never support)
RESEARCH_TRIAL_REGISTRY=true
RESEARCH_TRIALS_PER_QUERY=3
# openFDA: CAERS adverse-event reports for the product + drug labels naming an ingredient
RESEARCH_OPENFDA=true
# Database look-ups (openFDA, NIH ODS, NCCIH, DSLD labels) per research run
RESEARCH_MAX_LOOKUP_CALLS=40
# Product sources besides the web search: dsld, dgda, pharmacy
RESEARCH_PRODUCT_SOURCES=dsld,dgda,pharmacy
# Reference knowledge per ingredient: idisk (needs scripts/load_idisk.py), nccih, ods
# (ods is off by default: in Nov 2026 the ODS API and fact-sheet pages answered 403 to scripts)
RESEARCH_REFERENCE_SOURCES=idisk,nccih
IDISK_DB_PATH=./data/knowledge/idisk.sqlite
# Bangla-Latin ingredient dictionary (empty = bundled app/services/knowledge/data/ingredient_dictionary.csv)
INGREDIENT_DICTIONARY_PATH=
INGREDIENT_MATCH_THRESHOLD=86
# Evidence selection: auto (neural if requirements-ml.txt is installed, else BM25) | bm25 | embedding
EVIDENCE_SELECTOR=auto
EVIDENCE_TOP_K=5
EVIDENCE_EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
EVIDENCE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Rank sentences that report results/conclusions above titles, background, aims and advice (0 = relevance only)
EVIDENCE_ROLE_BONUS=0.35
# Claim verifier: auto | rules | ensemble | ensemble+rules | llm_baseline | llm_baseline+rules
VERIFIER_MODE=auto
# Fine-tuned model folders (from verifier_training/), comma separated; empty = rules only
VERIFIER_MODEL_DIRS=
VERIFIER_MAX_LENGTH=256
LLM_MIN_SECONDS_BETWEEN_CALLS=4
